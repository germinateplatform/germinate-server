---
layout: null
---
{% assign pages_list = site.pages | where_exp: "p", "p.title != nil" %}
{% assign comma = "" %}
[
{% for page in pages_list %}
  {% unless page.url contains '/assets/' or page.url == '/search.json' %}
  {{ comma }}{
    "title": {{ page.title | jsonify }},
    "url": {{ page.url | relative_url | jsonify }},
    "excerpt": {{ page.content | strip_html | normalize_whitespace | truncate: 220 | jsonify }},
    "content": {{ page.content | strip_html | normalize_whitespace | jsonify }}
  }
  {% assign comma = "," %}
  {% endunless %}
{% endfor %}
]